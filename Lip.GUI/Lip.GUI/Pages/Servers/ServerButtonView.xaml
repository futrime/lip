<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lip.GUI.Pages.Servers.ServerButtonView"
             Margin="10">

    <Button Background="{DynamicResource LayerOnAcrylicFillColorDefault}"
            HeightRequest="128"
            WidthRequest="128"
            BorderColor="{AppThemeBinding Light={DynamicResource Magenta}, Dark={DynamicResource White}}"
            BorderWidth="1">

        <Button.ImageSource>

            <FontImageSource
            Glyph="&#xE8BE;"
            Color="{AppThemeBinding Light={DynamicResource Magenta}, Dark={DynamicResource White}}"
            FontFamily="Segoe Fluent Icons"/>

        </Button.ImageSource>

        </Button>

</ContentView>
