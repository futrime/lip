<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Lip.GUI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:bedrinth="clr-namespace:Lip.GUI.Pages.Bedrinth"
    xmlns:fonts="clr-namespace:Fonts"
    xmlns:home="clr-namespace:Lip.GUI.Pages.Home"
    xmlns:local="clr-namespace:Lip.GUI"
    xmlns:server="clr-namespace:Lip.GUI.Pages.Servers"
    xmlns:settings="clr-namespace:Lip.GUI.Pages.Settings"
    Title="Lip.GUI"
    Shell.FlyoutBehavior="Flyout">

    <TabBar>

        <Tab Title="Home" Icon="fluent_home_32_regular.png">

            <ShellContent ContentTemplate="{DataTemplate home:HomePage}" />

        </Tab>

        <Tab Title="Server" Icon="fluent_remote_20_filled.png">

            <ShellContent ContentTemplate="{DataTemplate server:ServersPage}" />

        </Tab>

        <Tab Title="Bedrinth" Icon="fluent_apps_48_filled.png">

            <ShellContent ContentTemplate="{DataTemplate bedrinth:BedrinthPage}" />

        </Tab>

        <Tab Title="Settings" Icon="fluent_settings_24_regular.png">

            <ShellContent ContentTemplate="{DataTemplate settings:SettingsPage}" />

        </Tab>

    </TabBar>

</Shell>
